# MySQL (Hostinger)
DATABASE_URL="mysql://USUARIO:CONTRASEÑA@localhost:3306/NOMBRE_BD"

# JWT
JWT_SECRET="change-this-to-a-random-64-char-string-in-production-never-commit"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="production"
CORS_ORIGIN="https://yourdomain.com"
LOG_LEVEL="info"

# Restablecer contraseña por correo (opcional: sin esto no se envían correos)
# APP_URL: dirección pública de la app, SIN barra final. Es la única base de los enlaces del correo.
APP_URL=""
SMTP_HOST=""
SMTP_PORT=587
# true para el puerto 465 (TLS directo); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Si se omite, se usa: Neurofic <SMTP_USER>
SMTP_FROM=""
